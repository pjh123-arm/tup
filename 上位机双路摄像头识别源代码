# ============================================================================
# YoLov8TRT 类 (保持原样)
# ============================================================================
class YoLov8TRT(object):
    def __init__(self, engine_file_path):
        self.ctx = cuda.Device(0).make_context()
        stream = cuda.Stream()
        TRT_LOGGER = trt.Logger(trt.Logger.INFO)
        runtime = trt.Runtime(TRT_LOGGER)

        with open(engine_file_path, "rb") as f:
            engine = runtime.deserialize_cuda_engine(f.read())
        context = engine.create_execution_context()

        host_inputs, cuda_inputs, host_outputs, cuda_outputs, bindings = [], [], [], [], []
        for binding in engine:
            size = trt.volume(engine.get_binding_shape(binding)) * engine.max_batch_size
            dtype = trt.nptype(engine.get_binding_dtype(binding))
            host_mem = cuda.pagelocked_empty(size, dtype)
            cuda_mem = cuda.mem_alloc(host_mem.nbytes)
            bindings.append(int(cuda_mem))
            if engine.binding_is_input(binding):
                self.input_w = engine.get_binding_shape(binding)[-1]
                self.input_h = engine.get_binding_shape(binding)[-2]
                host_inputs.append(host_mem)
                cuda_inputs.append(cuda_mem)
            else:
                host_outputs.append(host_mem)
                cuda_outputs.append(cuda_mem)

        self.stream = stream
        self.context = context
        self.engine = engine
        self.host_inputs, self.cuda_inputs = host_inputs, cuda_inputs
        self.host_outputs, self.cuda_outputs = host_outputs, cuda_outputs
        self.bindings = bindings
        self.batch_size = engine.max_batch_size
        self.det_output_length = host_outputs[0].shape[0]

    def infer(self, raw_image_generator):
        self.ctx.push()
        stream, context = self.stream, self.context
        host_inputs, cuda_inputs = self.host_inputs, self.cuda_inputs
        host_outputs, cuda_outputs = self.host_outputs, self.cuda_outputs
        bindings = self.bindings

        batch_image_raw, batch_origin_h, batch_origin_w = [], [], []
        batch_input_image = np.empty(shape=[self.batch_size, 3, self.input_h, self.input_w])

        for i, image_raw in enumerate(raw_image_generator):
            input_image, image_raw, origin_h, origin_w = self.preprocess_image(image_raw)
            batch_image_raw.append(image_raw)
            batch_origin_h.append(origin_h)
            batch_origin_w.append(origin_w)
            np.copyto(batch_input_image[i], input_image)
        batch_input_image = np.ascontiguousarray(batch_input_image)

        np.copyto(host_inputs[0], batch_input_image.ravel())
        start = time.time()
        cuda.memcpy_htod_async(cuda_inputs[0], host_inputs[0], stream)
        context.execute_async(batch_size=self.batch_size, bindings=bindings, stream_handle=stream.handle)
        cuda.memcpy_dtoh_async(host_outputs[0], cuda_outputs[0], stream)
        stream.synchronize()
        end = time.time()
        self.ctx.pop()

        output = host_outputs[0]
        result_boxes_list, result_scores_list, result_classid_list = [], [], []
        for i in range(self.batch_size):
            result_boxes, result_scores, result_classid = self.post_process(
                output[i * self.det_output_length:(i + 1) * self.det_output_length], batch_origin_h[i],
                batch_origin_w[i]
            )
            result_boxes_list.append(result_boxes)
            result_scores_list.append(result_scores)
            result_classid_list.append(result_classid)

        return batch_image_raw, end - start, result_boxes_list, result_scores_list, result_classid_list

    def destroy(self):
        self.ctx.pop()

    def get_raw_image_zeros(self):
        for _ in range(self.batch_size):
            yield np.zeros([self.input_h, self.input_w, 3], dtype=np.uint8)

    def preprocess_image(self, raw_bgr_image):
        image_raw = raw_bgr_image
        h, w, c = image_raw.shape
        image = cv2.cvtColor(image_raw, cv2.COLOR_BGR2RGB)
        r_w, r_h = self.input_w / w, self.input_h / h
        if r_h > r_w:
            tw, th = self.input_w, int(r_w * h)
            tx1 = tx2 = 0
            ty1, ty2 = int((self.input_h - th) / 2), self.input_h - th - int((self.input_h - th) / 2)
        else:
            tw, th = int(r_h * w), self.input_h
            tx1, tx2 = int((self.input_w - tw) / 2), self.input_w - tw - int((self.input_w - tw) / 2)
            ty1 = ty2 = 0
        image = cv2.resize(image, (tw, th))
        image = cv2.copyMakeBorder(image, ty1, ty2, tx1, tx2, cv2.BORDER_CONSTANT, None, (128, 128, 128))
        image = image.astype(np.float32) / 255.0
        image = np.transpose(image, [2, 0, 1])
        image = np.expand_dims(image, axis=0)
        return np.ascontiguousarray(image), image_raw, h, w

    def xywh2xyxy(self, origin_h, origin_w, x):
        y = np.zeros_like(x)
        r_w, r_h = self.input_w / origin_w, self.input_h / origin_h
        if r_h > r_w:
            y[:, 0], y[:, 2] = x[:, 0], x[:, 2]
            y[:, 1] = x[:, 1] - (self.input_h - r_w * origin_h) / 2
            y[:, 3] = x[:, 3] - (self.input_h - r_w * origin_h) / 2
            y /= r_w
        else:
            y[:, 0] = x[:, 0] - (self.input_w - r_h * origin_w) / 2
            y[:, 2] = x[:, 2] - (self.input_w - r_h * origin_w) / 2
            y[:, 1], y[:, 3] = x[:, 1], x[:, 3]
            y /= r_h
        return y

    def post_process(self, output, origin_h, origin_w):
        num_values_per_detection = DET_NUM + SEG_NUM + POSE_NUM + OBB_NUM
        num = int(output[0])
        pred = np.reshape(output[1:], (-1, num_values_per_detection))[:num, :]
        boxes = self.non_max_suppression(pred, origin_h, origin_w, conf_thres=CONF_THRESH, nms_thres=IOU_THRESHOLD)

        if len(boxes) > 0:
            filtered_boxes = []
            for box in boxes:
                x1, y1, x2, y2 = box[:4]
                w, h = x2 - x1, y2 - y1
                area, aspect_ratio = w * h, w / h if h > 0 else 0
                if (MIN_BOX_AREA <= area <= MAX_BOX_AREA and MIN_ASPECT_RATIO <= aspect_ratio <= MAX_ASPECT_RATIO):
                    filtered_boxes.append(box)
            boxes = np.array(filtered_boxes) if filtered_boxes else np.array([])

        return (boxes[:, :4], boxes[:, 4], boxes[:, 5]) if len(boxes) else (np.array([]), np.array([]), np.array([]))

    def bbox_iou(self, box1, box2):
        b1_x1, b1_y1, b1_x2, b1_y2 = box1[:, 0], box1[:, 1], box1[:, 2], box1[:, 3]
        b2_x1, b2_y1, b2_x2, b2_y2 = box2[:, 0], box2[:, 1], box2[:, 2], box2[:, 3]
        inter_rect_x1 = np.maximum(b1_x1, b2_x1)
        inter_rect_y1 = np.maximum(b1_y1, b2_y1)
        inter_rect_x2 = np.minimum(b1_x2, b2_x2)
        inter_rect_y2 = np.minimum(b1_y2, b2_y2)
        inter_area = np.clip(inter_rect_x2 - inter_rect_x1 + 1, 0, None) * np.clip(inter_rect_y2 - inter_rect_y1 + 1, 0, None)
        b1_area = (b1_x2 - b1_x1 + 1) * (b1_y2 - b1_y1 + 1)
        b2_area = (b2_x2 - b2_x1 + 1) * (b2_y2 - b2_y1 + 1)
        return inter_area / (b1_area + b2_area - inter_area + 1e-16)

    def non_max_suppression(self, prediction, origin_h, origin_w, conf_thres=0.5, nms_thres=0.4):
        boxes = prediction[prediction[:, 4] >= conf_thres]
        boxes[:, :4] = self.xywh2xyxy(origin_h, origin_w, boxes[:, :4])
        boxes[:, 0] = np.clip(boxes[:, 0], 0, origin_w - 1)
        boxes[:, 2] = np.clip(boxes[:, 2], 0, origin_w - 1)
        boxes[:, 1] = np.clip(boxes[:, 1], 0, origin_h - 1)
        boxes[:, 3] = np.clip(boxes[:, 3], 0, origin_h - 1)
        boxes = boxes[np.argsort(-boxes[:, 4])]
        keep_boxes = []
        while boxes.shape[0]:
            large_overlap = self.bbox_iou(np.expand_dims(boxes[0, :4], 0), boxes[:, :4]) > nms_thres
            label_match = boxes[0, -1] == boxes[:, -1]
            invalid = large_overlap & label_match
            keep_boxes += [boxes[0]]
            boxes = boxes[~invalid]
        return np.stack(keep_boxes, 0) if len(keep_boxes) else np.array([])


# ============================================================================
# 增强型基础检测处理器（vy-only 预测 + 完整 X 轴撞线检测）
# ============================================================================
class BaseDetectionProcessor:
    TRIGGER_HIGHLIGHT_FRAMES = 5

    def __init__(self, yolov8_wrapper, config=None, tracker_cfg=None, serial_conn=None, categories=None,
                 segment_offset=0):
        self.yolov8_wrapper = yolov8_wrapper
        self.config = config if config is not None else LineConfig()
        self.serial_conn = serial_conn
        self.categories = categories or ["corn"]
        self.triggered_records = defaultdict(lambda: defaultdict(bool))
        self.segment_offset = segment_offset

        tk_cfg = tracker_cfg or {}
        cl_cfg = self.config.center_line_config
        self.tracker = MultiObjectTracker(
            max_age=tk_cfg.get('max_age', 60), min_hits=tk_cfg.get('min_hits', 1),
            iou_threshold=tk_cfg.get('iou_threshold', 0.2), predict_frames=tk_cfg.get('predict_frames', 60),
            cl_ratio=cl_cfg.get('center_line_ratio', 0.5), cl_extend=cl_cfg.get('extend_ratio', 0.0),
            dist_threshold=tk_cfg.get('dist_threshold', 120), recover_max_age=tk_cfg.get('recover_max_age', 60)
        )
        self.segment_highlight = {}
        self.all_visible_y = []

    def _get_class_name(self, class_id):
        cid = int(class_id)
        return self.categories[cid] if 0 <= cid < len(self.categories) else str(cid)

    def _get_segment_ys(self, segments):
        return {seg['id']: (seg['start'][1] + seg['end'][1]) // 2 for seg in segments}

    def get_segment_lines(self, width, height):
        segments = []
        cfg = self.config
        num_segments = min(cfg.num_segments, 8)
        if cfg.layout_mode == 'horizontal':
            hc = cfg.horizontal_config
            center_y = int(height * hc['y_position_ratio'])
            seg_w = int(width * hc['segment_width_ratio'])
            gap = int(width * hc['gap_ratio'])
            offset = int(width * hc['start_offset_ratio'])
            total_seg_width = num_segments * seg_w + (num_segments - 1) * gap
            if total_seg_width > width:
                gap = max(5, int((width - num_segments * seg_w) / (num_segments - 1)))
            for i in range(num_segments):
                sx = offset + i * (seg_w + gap)
                ex = min(sx + seg_w, width)

                global_id = i + self.segment_offset
                if sx < width:
                    segments.append(
                        {'start': (sx, center_y), 'end': (ex, center_y),
                         'color': cfg.colors[global_id % len(cfg.colors)],
                         'id': i}
                    )
        return segments

    def draw_segment_lines(self, frame, segments):
        for seg in segments:
            sid = seg['id']
            global_id = sid + self.segment_offset
            highlight = self.segment_highlight.get(sid)
            if highlight and highlight['remaining'] > 0:
                line_color = (255, 255, 255) if highlight['remaining'] % 2 == 1 else (0, 255, 255)
                cv2.line(frame, seg['start'], seg['end'], line_color, self.config.thickness + 4, cv2.LINE_AA)
                mx, my = (seg['start'][0] + seg['end'][0]) // 2, (seg['start'][1] + seg['end'][1]) // 2

                cmd_val = self.config.commands[global_id].decode('utf-8') if global_id < len(self.config.commands) else str(global_id)
                alert_text = f"SEND: {cmd_val} ID:{highlight['track_id']}"
                cv2.putText(frame, alert_text, (mx - 50, my - 15), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 0, 255), 2)
                highlight['remaining'] -= 1
            else:
                cv2.line(frame, seg['start'], seg['end'], seg['color'], self.config.thickness, cv2.LINE_AA)

    def _activate_segment_highlight(self, seg_id, track_id, trigger_type='normal'):
        self.segment_highlight[seg_id] = {'remaining': self.TRIGGER_HIGHLIGHT_FRAMES, 'track_id': track_id, 'type': trigger_type}

    def _compute_center_line(self, box, image_width):
        cl_cfg = self.config.center_line_config
        return compute_center_line_from_bbox(box, image_width, cl_cfg.get('center_line_ratio', 0.5), cl_cfg.get('extend_ratio', 0.0))

    def _is_prediction_still_useful_for_segment(self, tracker, pred_cl, seg, extra_margin=10):
        vy = tracker.get_effective_velocity()
        if vy is None: return True
        cy, seg_mid_y = pred_cl[1], (seg['start'][1] + seg['end'][1]) / 2.0
        tol = COLLISION_Y_TOLERANCE + extra_margin
        if vy > 0 and cy > seg_mid_y + tol: return False
        if vy < 0 and cy < seg_mid_y - tol: return False
        return True

    def _check_collision(self, center_line, segments, track_id):
        triggered = []
        csx, cy, cex, _ = center_line
        tol = COLLISION_Y_TOLERANCE
        for seg in segments:
            sid = seg['id']
            ss, se = seg['start'], seg['end']
            if ss[1] == se[1] and abs(cy - ss[1]) <= tol:
                if not (cex < min(ss[0], se[0]) or csx > max(ss[0], se[0])):
                    if not self.triggered_records[track_id][sid]:
                        triggered.append(sid)
                        self.triggered_records[track_id][sid] = True
        return triggered

    def _send_serial(self, seg_id):
        global_id = seg_id + self.segment_offset
        if self.serial_conn is not None and global_id < len(self.config.commands):
            with SERIAL_LOCK:
                try:
                    self.serial_conn.write(self.config.commands[global_id])
                    print(f"[触发] 摄像头偏移={self.segment_offset} 发送串口命令: {self.config.commands[global_id].decode('utf-8')}")
                except Exception as e:
                    print(f"[串口] 发送失败: {e}")

    def process_frame(self, frame, send_serial=True, conf_thresh=0.5):
        height, width = frame.shape[:2]
        segments = self.get_segment_lines(width, height)
        segment_ys = self._get_segment_ys(segments)

        batch_image_raw, inference_time, result_boxes_list, result_scores_list, result_classid_list = \
            self.yolov8_wrapper.infer([frame])

        if not batch_image_raw:
            return frame, 0, 0, 0, {'normal_triggers': [], 'predicted_triggers': []}

        processed_frame = batch_image_raw[0]
        detections = []
        if len(result_boxes_list[0]) > 0:
            for i in range(len(result_boxes_list[0])):
                detections.append(list(result_boxes_list[0][i]) + [float(result_scores_list[0][i]), int(result_classid_list[0][i])])

        visible_objects, predicted_trackers = self.tracker.update(detections, image_width=width)
        all_triggered = []
        active_ids = set()
        trigger_info = {'normal_triggers': [], 'predicted_triggers': []}

        for obj in visible_objects:
            x1, y1, x2, y2, conf, cls_id, tid = obj
            tid, cls_id = int(tid), int(cls_id)
            active_ids.add(tid)
            class_name = self._get_class_name(cls_id)
            is_crop = 'crop' in class_name.lower() or 'corn' in class_name.lower()

            if is_crop:
                cv2.rectangle(processed_frame, (int(x1), int(y1)), (int(x2), int(y2)), (0, 255, 0), 2)
                cv2.putText(processed_frame, f"ID:{tid} {conf:.2f}", (int(x1), int(y1) - 5), cv2.FONT_HERSHEY_SIMPLEX,
                            0.5, (0, 255, 0), 2)

                if should_draw_center_line(class_name):
                    cl = self._compute_center_line([x1, y1, x2, y2], width)
                    cv2.line(processed_frame, (cl[0], cl[1]), (cl[2], cl[3]), (0, 255, 255), 2)
                    tracker_obj = self.tracker.get_tracker_by_id(tid)
                    if tracker_obj:
                        tracker_obj.update_center_line(cl, segment_ys)
                    triggered = self._check_collision(cl, segments, tid)
                    all_triggered.extend(triggered)
                    if triggered:
                        trigger_info['normal_triggers'].extend([{'track_id': tid, 'seg_id': s} for s in triggered])
                        for sid in triggered: self._activate_segment_highlight(sid, tid, 'normal')

        for tracker in predicted_trackers:
            tid = tracker.id
            active_ids.add(tid)
            for seg in segments:
                sid = seg['id']
                res = tracker.predict_center_line_for_segment(sid)
                if res:
                    pred_cl, base_cl, dt = res
                    if not self._is_prediction_still_useful_for_segment(tracker, pred_cl, seg): continue
                    triggered = self._check_collision(pred_cl, [seg], tid)
                    if triggered:
                        all_triggered.extend(triggered)
                        for s in triggered: self._activate_segment_highlight(s, tid, 'predict')

        self.draw_segment_lines(processed_frame, segments)
        if send_serial:
            for sid in set(all_triggered): self._send_serial(sid)

        return processed_frame, inference_time, len(detections), len(visible_objects), trigger_info


