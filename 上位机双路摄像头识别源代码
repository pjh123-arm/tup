                                                            serial_conn=serial_conn, categories=args.categories,
                                                            segment_offset=current_offset)
                grabbers[cam_id] = CameraGrabber(camera_id=cam_id)
                grabbers[cam_id].start()

                while not grabbers[cam_id].is_ready and GLOBAL_RUNNING:
                    time.sleep(0.1)
                time.sleep(1.5)

            print("🚀 所有硬件通道全部安全挂载完毕。主单线程流水线推理中心全面激活！")

            while GLOBAL_RUNNING:
                for cam_id in USE_CAMERA_IDS:
                    grabber = grabbers[cam_id]
                    if grabber.ret and grabber.frame is not None:
                        frame = grabber.frame.copy()

                        if CROP_ROI != [0.0, 0.0, 1.0, 1.0]:
                            h, w = frame.shape[:2]
                            xmin, ymin, xmax, ymax = CROP_ROI
                            x1, y1, x2, y2 = int(xmin * w), int(ymin * h), int(xmax * w), int(ymax * h)
                            frame = frame[y1:y2, x1:x2]

                        try:
                            processed_frame, inference_time, raw_count, tracked_count, trigger_info = \
                                processors[cam_id].process_frame(frame, send_serial=True, conf_thresh=args.conf)

                            total_normals[cam_id] += len(trigger_info['normal_triggers'])
                            total_predicts[cam_id] += len(trigger_info['predicted_triggers'])

                            info_text = [
                                f"Camera Channel: {cam_id}",
                                f"TRT Infer: {inference_time * 1000:.1f}ms",
                                f"Tracked Objects: {tracked_count}",
                                f"Triggers: normal={total_normals[cam_id]} pred={total_predicts[cam_id]}",
                            ]
                            for i, text in enumerate(info_text):
                                cv2.putText(processed_frame, text, (10, 30 + i * 25), cv2.FONT_HERSHEY_SIMPLEX, 0.6,
                                            (0, 255, 0), 2)

                            cv2.imshow(f'Detection - Camera {cam_id}', processed_frame)

                        except Exception as e:
                            traceback.print_exc()
                            cv2.imshow(f'Detection - Camera {cam_id}', frame)

                if cv2.waitKey(1) & 0xFF == ord('q'):
                    GLOBAL_RUNNING = False
                    break

            cv2.destroyAllWindows()

        elif args.mode == 'video':
            # 兼容视频模式回放，默认调取摄像头 0 的参数配置
            video_line_cfg = LineConfig()
            video_line_cfg.layout_mode = args.line_mode
            video_line_cfg.num_segments = args.num_segments
            if 0 in CAMERA_LINE_SETTINGS:
                video_line_cfg.horizontal_config.update(CAMERA_LINE_SETTINGS[0])
            else:
                video_line_cfg.horizontal_config['y_position_ratio'] = args.line_y
                video_line_cfg.horizontal_config['segment_width_ratio'] = args.line_width

            video_detector = VideoDetector(yolov8_wrapper, config=video_line_cfg, tracker_cfg=tracker_cfg,
                                           serial_conn=serial_conn, categories=args.categories)
            video_path = args.video or '/home/jetson/Desktop/crop2.mp4'
            video_detector.detect_video(video_path, output_path=args.output, show_display=not args.no_display,
                                        send_serial=args.send_serial, conf_thresh=args.conf)

    except KeyboardInterrupt:
        print("\n[系统安全退出] 键盘中断")
        GLOBAL_RUNNING = False
    finally:
        yolov8_wrapper.destroy()
        if serial_conn is not None: serial_conn.close()
        print("系统资源完全释放。")
