# 极轻量级硬件视频抓取流线程
# ============================================================================
class CameraGrabber(threading.Thread):
    def __init__(self, camera_id=0):
        threading.Thread.__init__(self)
        self.camera_id = camera_id
        self.capture = None
        self.frame = None
        self.ret = False
        self.is_ready = False

    def run(self):
        global GLOBAL_RUNNING
        try:
            print(f"[相机抓取流] 正在拉起底层 V4L2 硬件通道 ID: {self.camera_id}...")
            self.capture = cv2.VideoCapture(self.camera_id, cv2.CAP_V4L2)
            time.sleep(0.5)

            if not self.capture.isOpened():
                print(f"❌ [相机致命伤] 抓取流无法开启摄像头 ID: {self.camera_id}")
                return

            self.capture.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc(*'MJPG'))
            time.sleep(0.15)
            self.capture.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
            time.sleep(0.15)
            self.capture.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
            time.sleep(0.15)
            self.capture.set(cv2.CAP_PROP_FPS, 30)
            time.sleep(0.4)

            for _ in range(10):
                self.capture.read()
                time.sleep(0.02)

            self.is_ready = True
            print(f"✅ [相机抓取流] 摄像头 ID: {self.camera_id} 硬件初始化成功，进入轮询就绪态。")
        except Exception as e:
            print(f"❌ [相机致命异常] 摄像头 ID: {self.camera_id} 抓取流损坏: {e}")
            return

        while GLOBAL_RUNNING:
            ret, frame = self.capture.read()
            if ret:
                self.frame = frame
                self.ret = True
            else:
                time.sleep(0.01)

        if self.capture is not None:
            self.capture.release()


