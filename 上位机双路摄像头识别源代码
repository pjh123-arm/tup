    name = class_name.lower()
    if 'weed' in name:
        return CLASS_COLORS['weeds']
    elif 'crop' in name or 'corn' in name:
        return CLASS_COLORS['crop']
    return CLASS_COLORS.get(name, CLASS_COLORS['default'])


