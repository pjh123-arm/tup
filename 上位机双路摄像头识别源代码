class VideoDetector:
    def __init__(self, yolov8_wrapper, config=None, tracker_cfg=None, serial_conn=None, categories=None):
        self.config = config if config is not None else LineConfig()
        self.processor = BaseDetectionProcessor(yolov8_wrapper, config, tracker_cfg, serial_conn, categories, segment_offset=0)

    def detect_video(self, video_path, output_path=None, show_display=True, send_serial=False, conf_thresh=0.5):
        cap = cv2.VideoCapture(video_path)
        if not cap.isOpened(): return None
        fps, w, h = int(cap.get(cv2.CAP_PROP_FPS)), int(cap.get(cv2.CAP_PROP_FRAME_WIDTH)), int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
        writer = cv2.VideoWriter(output_path, cv2.VideoWriter_fourcc(*'mp4v'), fps, (w, h)) if output_path else None

        while True:
            ret, frame = cap.read()
            if not ret: break
            processed, inf_time, _, _, _ = self.processor.process_frame(frame, send_serial=send_serial, conf_thresh=conf_thresh)
            if writer: writer.write(processed)
            if show_display:
                cv2.imshow('Detection', processed)
                if cv2.waitKey(1) & 0xFF == ord('q'): break
        cap.release()
        if writer: writer.release()
        cv2.destroyAllWindows()


class warmUpThread(threading.Thread):
    def __init__(self, yolov8_wrapper):
        threading.Thread.__init__(self)
        self.yolov8_wrapper = yolov8_wrapper

    def run(self):
        with INFER_LOCK:
            self.yolov8_wrapper.infer(self.yolov8_wrapper.get_raw_image_zeros())


